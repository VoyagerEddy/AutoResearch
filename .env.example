# OpenRouter（必填；请勿提交真实 Key）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://127.0.0.1:8765

# AutoDL 容器实例 Pro API。Token 获取：控制台 → 账号 → 设置 → 开发者 Token
AUTODL_TOKEN=
AUTODL_IMAGE_UUID=
# 4090-48G 官方规格优先；5090 的规格 ID 若以后开放，可在第二项替换。
AUTODL_GPU_SPECS=v-48g,5090
AUTODL_CUDA_FROM=118

# 可选 GitHub 配置。远端仓库需要预先创建，且本机 Git 已完成身份认证。
GITHUB_REMOTE_URL=https://github.com/VoyagerEddy/AutoResearch.git
GITHUB_DEFAULT_BRANCH=main
GITHUB_TOKEN=

# 服务
AUTORESEARCH_HOST=127.0.0.1
AUTORESEARCH_PORT=8765
AUTORESEARCH_MONITOR_SECONDS=30
AUTORESEARCH_MAX_ITERATIONS=3

