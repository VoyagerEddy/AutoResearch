# OpenRouter (required for autonomous mode; never commit a real key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://127.0.0.1:8765

# AutoDL Container Instance Pro API. Get a token from Console > Account > Settings.
AUTODL_TOKEN=
# Optional override. Blank/missing uses AutoDL's documented public PyTorch
# 2.0.0 / CUDA 11.8 base image: base-image-l2t43iu6uk.
AUTODL_IMAGE_UUID=
# Official Pro API specs: prefer general-purpose 4090-48G, then performance 5090-32G.
AUTODL_GPU_SPECS=v-48g,5090-p
AUTODL_CUDA_FROM=118

# Optional GitHub configuration. Create the remote first and authenticate Git locally.
GITHUB_REMOTE_URL=https://github.com/VoyagerEddy/AutoResearch.git
GITHUB_DEFAULT_BRANCH=main
GITHUB_TOKEN=

# Service
AUTORESEARCH_HOST=127.0.0.1
AUTORESEARCH_PORT=8765
AUTORESEARCH_MONITOR_SECONDS=30
AUTORESEARCH_MAX_ITERATIONS=3
